generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Student {
  id       String  @id @default(cuid())
  fullName String
  email    String? @unique
  phone    String?
  isActive Boolean @default(true)

  enrollments Enrollment[]
  feePlan     StudentFeePlan?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Teacher {
  id       String  @id @default(cuid())
  fullName String
  email    String? @unique
  phone    String?
  isActive Boolean @default(true)

  classes TuitionClass[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TuitionClass {
  id      String @id @default(cuid())
  name    String
  subject String

  teacherId String
  teacher   Teacher @relation(fields: [teacherId], references: [id], onDelete: Restrict)

  enrollments Enrollment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Enrollment {
  id String @id @default(cuid())

  studentId      String
  tuitionClassId String

  student      Student      @relation(fields: [studentId], references: [id], onDelete: Restrict)
  tuitionClass TuitionClass @relation(fields: [tuitionClassId], references: [id], onDelete: Restrict)

  enrolledAt DateTime @default(now())

  @@unique([studentId, tuitionClassId])
}

model StudentFeePlan {
  id String @id @default(cuid())

  studentId String  @unique
  student   Student @relation(fields: [studentId], references: [id], onDelete: Restrict)

  monthlyFeeSen Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
